{
  "expo": {
    "name": "Poyraz Mobilya",
    "slug": "poyraz-mobil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "poyraz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.poyrazmobilya.app"
    },
    "android": {
      "package": "com.poyrazmobilya.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2E9BD6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 135,
          "resizeMode": "contain"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "404bcc57-7e02-42f2-8fab-fe601f55bee0"
      }
    },
    "owner": "aarslan223"
  }
}
